{
  "name": "ramgrouptalk",
  "productName": "RamGroupTalk",
  "version": "0.6.3",
  "description": "RamGroupTalk",
  "author": "김예람",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.yeram.ramgrouptalk",
    "productName": "RamGroupTalk",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "scripts/**",
      "package.json",
      "creds.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "RamGroupTalk-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "RamGroupTalk",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dpfkadpfka",
        "repo": "RamGroupTalk",
        "releaseType": "release"
      }
    ]
  }
}
